# Скопируйте этот файл в .env и заполните своими значениями.
# .env никогда не коммитить и не показывать никому — там секреты.

PORT=8787

# ---- YouTube Data API (подписчики) ----
# Ключ: console.cloud.google.com -> APIs & Services -> Credentials -> API key
# (включите "YouTube Data API v3" для проекта)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ---- Prodamus (деньги + продажи) ----
# У Продамус вебхуки, а не запрос по требованию: он сам шлёт POST на
# /webhooks/prodamus при каждой оплате. Секретный ключ — для проверки
# подписи входящего уведомления (личный кабинет -> Настройки платёжной формы).
PRODAMUS_SECRET_KEY=

# ---- VK (подписчики сообщества) ----
# Настройки сообщества -> Работа с API / Сообщения -> Ключи доступа -> Создать ключ
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# ---- Instagram (подписчики) ----
# Требует бизнес/авторский аккаунт, привязанный к странице Facebook.
# Meta for Developers -> Create App (Business) -> Graph API Explorer ->
# Generate Access Token (permissions: instagram_basic, pages_show_list,
# pages_read_engagement) -> me/accounts -> {page_id}?fields=instagram_business_account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ---- Точка Банк ----
# Подтверждено: https://enter.tochka.com/uapi/open-banking/v1.0
TOCHKA_ACCOUNT_ID=
TOCHKA_ACCESS_TOKEN=

# ---- Т-Банк / Тинькофф (Business API) ----
# Подтверждено: https://business.tbank.ru/openapi/api/v1/bank-statement
# Токен пока невалидный — ждём ответ поддержки
TINKOFF_ACCOUNT_NUMBER=
TINKOFF_ACCESS_TOKEN=

# ---- Сбербанк ----
# Уточнить, какой именно продукт из линейки Сбер API вы подключаете
# (Sber Business API / эквайринг / другое) — от этого зависит base URL и путь.
SBERBANK_BASE_URL=
SBERBANK_TRANSACTIONS_PATH=
SBERBANK_ACCESS_TOKEN=
