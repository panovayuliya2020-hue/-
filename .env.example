# Скопируйте этот файл в .env и заполните своими значениями.
# .env никогда не коммитить и не показывать никому — там секреты.

PORT=8787

# ---- YouTube Data API (подписчики) ----
# Ключ: console.cloud.google.com -> APIs & Services -> Credentials -> API key
# (включите "YouTube Data API v3" для проекта)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ---- Prodamus (деньги + продажи) ----
# Личный кабинет Продамус -> Настройки -> API
# BASE_URL — ваш поддомен, например https://имя.payform.ru
# ORDERS_PATH — точный путь эндпоинта заказов, посмотрите в документации API
# в личном кабинете (он завязан на версию API вашего аккаунта).
PRODAMUS_BASE_URL=
PRODAMUS_SECRET_KEY=
PRODAMUS_ORDERS_PATH=

# ---- Точка Банк ----
# Личный кабинет разработчика Точки -> регистрация приложения -> OAuth-токен
# TRANSACTIONS_PATH — путь эндпоинта выписки, из актуальной документации Open Banking API
TOCHKA_BASE_URL=
TOCHKA_TRANSACTIONS_PATH=
TOCHKA_ACCESS_TOKEN=

# ---- Тинькофф Банк (Business API) ----
TINKOFF_BASE_URL=
TINKOFF_TRANSACTIONS_PATH=
TINKOFF_ACCESS_TOKEN=

# ---- Сбербанк ----
# Уточнить, какой именно продукт из линейки Сбер API вы подключаете
# (Sber Business API / эквайринг / другое) — от этого зависит base URL и путь.
SBERBANK_BASE_URL=
SBERBANK_TRANSACTIONS_PATH=
SBERBANK_ACCESS_TOKEN=
